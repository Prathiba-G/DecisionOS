# ============================================================
# DecisionOS — Environment Configuration
# ============================================================

# Server Configuration
HOST=127.0.0.1
PORT=8000

# LLM Provider Configuration
# Supported providers: "gemini" | "openai" | "fallback"
# Note: If no API key is provided, DecisionOS automatically operates in
# deterministic fallback mode, ensuring 100% demo functionality.
LLM_PROVIDER=fallback
GEMINI_API_KEY=
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash

# Deterministic Scoring Factor Weights (Weights must sum to 1.0)
WEIGHT_ACV=0.25
WEIGHT_PURCHASE_DECLINE=0.25
WEIGHT_INACTIVITY=0.20
WEIGHT_SUPPORT_ISSUES=0.20
WEIGHT_ENGAGEMENT_DECLINE=0.10

# Priority Thresholds
HIGH_PRIORITY_THRESHOLD=65.0
MEDIUM_PRIORITY_THRESHOLD=40.0

# Sarvam Voice Agents Instant Outbound (backend only)
# Use the existing Voice Agent ID as app_id; never add this to Vite/frontend env.
SARVAM_APP_ID=
SARVAM_API_KEY=
# Sarvam API scope required by the documented Instant Outbound endpoint.
SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=
SARVAM_APP_VERSION=
# Phone-number telephony deployment required by Instant Outbound.
SARVAM_CONNECTION_ID=
SARVAM_AGENT_PHONE_NUMBER=
# Public URL mapped to /api/webhooks/sarvam/instant-outbound.
SARVAM_WEBHOOK_URL=
# Optional comma-separated list of agent variables configured as required in Sarvam.
SARVAM_REQUIRED_AGENT_VARIABLES=
